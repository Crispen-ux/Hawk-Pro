# Server-only settings. Never prefix these with VITE_.
DATABASE_URL=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
# HTTPS transactional email endpoint accepting {from,to,subject,html}, bearer auth.
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=
# Used only by db/create-admin.mjs. Remove initial password after provisioning.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Payflex hosted checkout — server only. Use sandbox on preview and live on production.
PAYFLEX_CLIENT_ID=
PAYFLEX_CLIENT_SECRET=
PAYFLEX_ENVIRONMENT=sandbox
# Exact HTTPS storefront origin, with no path, for payment return and callback URLs.
SITE_URL=
